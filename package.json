{
  "name": "demand-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/mirror-public.mjs && node scripts/generate-feed.mjs && node scripts/generate-sitemap.mjs",
    "build": "vite build && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "mirror": "node scripts/mirror-public.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "news": "node scripts/fetch-news.mjs",
    "themes": "node scripts/extract-demand-candidates.mjs",
    "themes:ai": "node scripts/analyze-themes.mjs",
    "trends": "node scripts/fetch-keyword-trends.mjs",
    "wiki": "node scripts/fetch-wikipedia-pageviews.mjs",
    "qiita": "node scripts/fetch-qiita.mjs",
    "appstore": "node scripts/fetch-appstore.mjs",
    "arxiv": "node scripts/fetch-arxiv.mjs",
    "github": "node scripts/fetch-github.mjs",
    "ndl": "node scripts/fetch-ndl.mjs",
    "check": "node scripts/check-sources.mjs",
    "demands": "node scripts/build-demands.mjs",
    "insights": "node scripts/generate-insights.mjs",
    "validate": "node scripts/validate-data.mjs",
    "sources:report": "node scripts/build-source-report.mjs",
    "feed": "node scripts/generate-feed.mjs",
    "history": "node scripts/append-history.mjs",
    "all": "npm run news && npm run themes && npm run trends && npm run wiki && npm run qiita && npm run appstore && npm run arxiv && npm run github && npm run ndl && npm run check && npm run demands && npm run insights && npm run validate && npm run sources:report && npm run feed && npm run history && npm run mirror",
    "themes:eval": "node scripts/evaluate-themes.mjs",
    "visits:check": "node scripts/check-visits.mjs",
    "contact:read": "node scripts/read-contact.mjs",
    "completeness": "node scripts/check-completeness.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@vitejs/plugin-react": "^4.3.1",
    "rss-parser": "^3.13.0",
    "vite": "^5.4.8"
  }
}
