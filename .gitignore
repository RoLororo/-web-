# dependencies
node_modules/

# build output
dist/

# env & secrets
.env
.env.local
.env.*.local

# editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.vercel
.claude/

# public/ ミラーは build 時に scripts/mirror-public.mjs が生成する派生物。
# canonical (data/, history/) だけを git 追跡する (二重管理解消)。
public/data/
public/history/

# sitemap.xml は demands.json から prebuild で生成する派生物。
# 手書きすると必ずテーマ増減とずれるので追跡しない (robots.txt は静的なので追跡する)。
public/sitemap.xml

# feed.xml も prebuild で生成される派生物。
# 蓄積の本体は data/feed-items.jsonl と data/feed-state.json（こちらは追跡する）。
public/feed.xml

# プリレンダ時の SSR 中間ビルド（実行後に消えるが念のため）
.ssr-build/
