# ============================================================================
# Demand Atlas — 環境変数のサンプル
#
# このファイルをコピーして .env を作成し、実際の値を書き込んでください:
#   cp .env.example .env
#
# .env は .gitignore に登録されているため、Git には含まれません。
# ============================================================================

# Anthropic API キー (必須 / npm run themes:ai で使用)
# 取得: https://console.anthropic.com/ → 左メニュー "API Keys"
ANTHROPIC_API_KEY=

# 使用するモデル (任意 / 省略時は claude-sonnet-5)
# 選択肢の例:
#   claude-sonnet-5     ← コストと性能のバランス (デフォルト)
#   claude-haiku-4-5    ← より安く、簡単な分類向き
#   claude-opus-4-8     ← より高性能、複雑な推論向き
# ANTHROPIC_MODEL=claude-sonnet-5


# ============================================================================
# 保存先パスとストレージ挙動 (すべて任意、未設定なら現行 default = ローカル fs)
#
# scripts/lib/paths.mjs が env で default を上書き可能にしている。
# staging/prod 分離、DB/Storage 移行前の実験、GH Actions での挙動切替等に使う。
# ============================================================================

# ── パス系 (未設定なら {repo}/data, {repo}/history, {repo}/public を使う) ──
# DATA_ROOT=./data
# HISTORY_ROOT=./history
# PUBLIC_ROOT=./public
# CONFIG_ROOT=./config

# ── history 挙動 ──
# HISTORY_RETENTION_DAYS=90            # current にキープする日数
# HISTORY_ARCHIVE_STRATEGY=year        # year | month (現在 year のみ)

# ── ストレージ driver (将来切替用、現在は fs のみ実装) ──
# STORAGE_DRIVER=fs                    # fs | turso | r2
# TURSO_DATABASE_URL=libsql://...      # future
# TURSO_AUTH_TOKEN=...                 # future
# R2_ENDPOINT=https://...              # future
# R2_ACCESS_KEY_ID=...                 # future
# R2_SECRET_ACCESS_KEY=...             # future
# R2_BUCKET=demand-atlas               # future


# ============================================================================
# 「今日訪れた人」のカウンタ（api/visit.js が使う・Vercel 側にだけ設定する）
#
# Vercel → Storage → Redis（Upstash 無料枠）を Connect すると自動で入る。
# **未設定なら API は { available: false } を返し、Home には何も表示されない**
# （0 人と表示して実測していない主張をしないため）。
#
# ローカル開発では未設定のままで良い（Vite は /api を配信しないため）。
# ============================================================================

# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=      # Upstash 直結の場合はこちらでも動く
# UPSTASH_REDIS_REST_TOKEN=
